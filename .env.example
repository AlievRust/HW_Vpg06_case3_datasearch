# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Yandex AI Studio через OpenAI-совместимый API
YANDEX_API_KEY=your_yandex_api_key
YANDEX_FOLDER_ID=your_folder_id
YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEXGPT_MODEL=gpt://your_folder_id/yandexgpt/latest
YANDEX_EMBEDDING_MODEL=emb://your_folder_id/text-search-doc/latest
YANDEX_QUERY_EMBEDDING_MODEL=emb://your_folder_id/text-search-query/latest
# Отдельная VLM-модель Yandex AI Studio для анализа картинки собаки.
# Если значение не задано, hay_bot.py построит URI актуальной VLM по YANDEX_FOLDER_ID.
YANDEX_VISION_MODEL=gpt://your_folder_id/qwen3.6-35b-a3b
# Для описания картинки рассуждение отключено: это экономит токены и не даёт
# модели потратить весь лимит на reasoning_content без итогового content.
YANDEX_VISION_REASONING_EFFORT=none

# ChromaDB
CHROMA_COLLECTION=assistant_memory
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# История полных реплик хранится в отдельной коллекции ChromaDB.
CHROMA_DIALOGUE_COLLECTION=assistant_dialogue

# Память и ответы
MEMORY_CONTEXT_SIZE=5
MEMORY_SEARCH_CANDIDATES=5
MEMORY_MAX_DISTANCE=0.8
MEMORY_MIN_CONFIDENCE=0.7
# Количество последних пар «пользователь — бот» для понимания неполных фраз
MEMORY_RECENT_TURNS=3
# Сколько релевантных реплик диалога добавлять в контекст Haystack-агента.
DIALOGUE_CONTEXT_SIZE=6
# Сколько последних реплик (в хронологическом порядке) добавлять дополнительно.
DIALOGUE_RECENT_TURNS=6
# Сетевые тайм-ауты внешних бесплатных API и запросов VLM, в секундах.
EXTERNAL_API_TIMEOUT=20
LOG_LEVEL=INFO
